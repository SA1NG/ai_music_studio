# ===== Hồ sơ máy DEV (RTX 3060 12GB, ACE-Step turbo không LM) =====
# Copy thành .env (scripts/setup làm việc này nếu .env chưa có).
# Máy không GPU: đặt cả ba *_BACKEND=mock.

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Worker/UI dùng địa chỉ này để gọi API. Worker ở máy khác: trỏ tới IP máy chạy API.
API_URL=http://127.0.0.1:8000
# Bỏ trống = tắt bảo vệ. Nếu đặt, mọi request phải gửi header X-Token.
API_TOKEN=
DATA_DIR=data
# Worker im lặng quá số giây này -> job đang chạy của nó về lại hàng đợi
JOB_STALE_SECONDS=60
WORKER_ONLINE_SECONDS=30

# --- UI ---
UI_HOST=127.0.0.1
UI_PORT=7860

# --- Worker: backend theo từng loại job (mock | ace) ---
# BACKEND=... (cũ) vẫn được hiểu: là giá trị mặc định cho cả ba biến dưới đây.
GENERATE_BACKEND=ace
AUTOLABEL_BACKEND=ace
TRAIN_BACKEND=ace
# Bỏ trống = tên máy + pid. Đặt cố định để job dở dang được trả lại hàng đợi ngay khi worker khởi động lại.
WORKER_ID=dev-worker
WORKER_TYPES=generate,autolabel,train
WORKER_POLL_INTERVAL=2

# --- ACE-Step API server (cài riêng ngoài dự án, chạy: uv run acestep-api) ---
ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
# Máy 3060 12GB: không dùng LM (ACESTEP_INIT_LLM=false bên ACE-Step) -> chỉ có "none"
ACESTEP_LM_MODELS=
ACESTEP_POLL_INTERVAL=2
ACESTEP_TIMEOUT=900
ACESTEP_INFERENCE_STEPS=8
# Train/LoRA với ACE-Step: thư mục làm việc PHẢI nằm trong thư mục ACE-Step-1.5 (ACE-Step chặn đường dẫn ngoài).
# Worker có backend ace phải chạy CÙNG MÁY với ACE-Step.
ACESTEP_WORK_DIR=D:/ACE-Step-1.5/music_studio_work
ACESTEP_TRAIN_TIMEOUT=3600
ACESTEP_TRAIN_GRAD_CHECKPOINTING=true

# --- Model ---
# Với GENERATE_BACKEND=ace, danh sách DiT lấy động từ ACE-Step (GET /v1/model_inventory).
# Dưới đây chỉ dùng khi GENERATE_BACKEND=mock.
MOCK_DIT_MODELS=acestep-v15-turbo
MOCK_LM_MODELS=none
DEFAULT_DIT_MODEL=acestep-v15-turbo
DEFAULT_LM_MODEL=none
MOCK_DELAY_MIN=2
MOCK_DELAY_MAX=5
MOCK_TRAIN_SECONDS=25

# --- Prompt refiner: noop | claude ---
PROMPT_REFINER=noop
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Independent audio check: official Essentia command-line extractor.
ESSENTIA_ENABLED=true
ESSENTIA_TIMEOUT=180

# --- Cập nhật online ---
# URL tới latest.json. Bỏ trống = dùng địa chỉ ghi sẵn trong gói (release.json); cả hai trống = tắt.
UPDATE_URL=
