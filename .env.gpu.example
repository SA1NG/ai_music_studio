# ===== Hồ sơ máy GPU (chạy ACE-Step 1.5 thật) =====
# cp .env.gpu.example .env   rồi chỉnh lại cho máy của bạn.
# ACE-Step-1.5 cài RIÊNG (venv/uv riêng), chạy:  uv run acestep-api   (mặc định cổng 8001)

# --- API ---
# 0.0.0.0 nếu worker/UI chạy ở máy khác (nhớ đặt API_TOKEN!)
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
API_TOKEN=
DATA_DIR=data
JOB_STALE_SECONDS=120
WORKER_ONLINE_SECONDS=30

# --- UI ---
UI_HOST=127.0.0.1
UI_PORT=7860

# --- Worker: backend theo từng loại job (mock | ace) ---
GENERATE_BACKEND=ace
AUTOLABEL_BACKEND=ace
TRAIN_BACKEND=ace
WORKER_ID=gpu-worker-1
WORKER_TYPES=generate,autolabel,train
WORKER_POLL_INTERVAL=2

# --- ACE-Step API server ---
ACESTEP_URL=http://127.0.0.1:8001
# Trùng với ACESTEP_API_KEY / --api-key của acestep-api (bỏ trống nếu server không bật auth)
ACESTEP_API_KEY=
# Danh sách DiT lấy từ GET {ACESTEP_URL}/v1/models. Danh sách LM khai báo ở đây ("none" luôn có).
ACESTEP_LM_MODELS=acestep-5Hz-lm-1.7B
ACESTEP_POLL_INTERVAL=2
ACESTEP_TIMEOUT=1800
# 0 = để server tự chọn mặc định (turbo: 8)
ACESTEP_INFERENCE_STEPS=0
# Train/LoRA: thư mục PHẢI nằm trong thư mục cài ACE-Step-1.5; worker chạy cùng máy với ACE-Step
ACESTEP_WORK_DIR=/opt/ACE-Step-1.5/music_studio_work
ACESTEP_TRAIN_TIMEOUT=7200
ACESTEP_TRAIN_GRAD_CHECKPOINTING=true

# --- Model mặc định ---
DEFAULT_DIT_MODEL=acestep-v15-xl-sft
DEFAULT_LM_MODEL=acestep-5Hz-lm-1.7B

# --- Prompt refiner: noop | claude ---
PROMPT_REFINER=noop
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Independent audio check: official Essentia command-line extractor.
ESSENTIA_ENABLED=true
ESSENTIA_TIMEOUT=180

# --- Cập nhật online ---
# URL tới latest.json. Bỏ trống = dùng địa chỉ ghi sẵn trong gói (release.json); cả hai trống = tắt.
UPDATE_URL=
